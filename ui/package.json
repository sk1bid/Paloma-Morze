{
  "name": "ui",
  "private": true,
  "version": "0.4.7",
  "author": "Paloma Morse Team",
  "description": "Premium Morse Code Training application with cross-platform C++ engine.",
  "repository": {
    "type": "git",
    "url": "https://gitlab.sk1bid.ru/root/paloma-morze.git"
  },
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "vite",
    "dev:electron": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && npm start\"",
    "sync-version": "bash ../scripts/update_version.sh",
    "prebuild": "npm run sync-version",
    "build": "vite build",
    "build:app": "npm run sync-version && electron-builder",
    "publish:app": "npm run sync-version && electron-builder -mwl -p always",
    "lint": "eslint .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "preview": "vite preview",
    "release": "bash ../scripts/tag_release.sh"
  },
  "build": {
    "appId": "com.paloma.morse",
    "productName": "Paloma-Morse",
    "asarUnpack": [
      "native/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "sk1bid",
        "repo": "Paloma-Morze"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "bridge.cjs",
      "assets/icon.*",
      "native/**/*"
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "artifactName": "${productName}.${version}.${ext}",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icon.png",
      "artifactName": "${productName}.Setup.${version}.${ext}",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "artifactName": "${productName}.${version}.${ext}",
      "target": [
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "axios": "^1.15.0",
    "electron-updater": "^6.8.3",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.6.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "socket.io-client": "^4.8.3",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jest": "^30.3.0",
    "js-yaml": "^4.1.1",
    "semver": "^7.7.4",
    "vite": "^8.0.1",
    "wait-on": "^9.0.4"
  }
}
