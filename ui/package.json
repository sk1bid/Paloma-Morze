{
  "name": "ui",
  "private": true,
  "version": "0.1.0-beta",
  "author": "Paloma Morse Team",
  "description": "Premium Morse Code Training application with cross-platform C++ engine.",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "vite",
    "build": "vite build",
    "build:app": "electron-builder",
    "publish:app": "electron-builder -mwl -p always",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.paloma.morse",
    "productName": "Paloma Morse",
    "publish": [
      {
        "provider": "gitlab",
        "url": "https://gitlab.sk1bid.ru"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "bridge.cjs",
      "assets/icon.*",
      "native/**/*"
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.6.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^41.0.4",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^8.0.1"
  }
}
